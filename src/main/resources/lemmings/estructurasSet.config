# ==============================================
# Configuración de Estructuras para Lemmings
# Formato: carácter=ruta_imagen,tipo,colision
# ==============================================

# ========= BLOQUES INDESTRUCTIBLES ============
# Metal sólido (variante 1)
M=/lemmings/bloques/cuadradoMetal.png,indestructible,true
Y=/lemmings/bloques/cuadradoMetalv2.png,indestructible,true
# Metal sólido (variante 2)
N=/lemmings/bloques/dobleCuadradoMetal.png,indestructible,true

# Rellenos metal
R=/lemmings/bloques/relleno.png,indestructible,true
I=/lemmings/bloques/relleno2.png,indestructible,true
Q=/lemmings/bloques/tuboMetal.png,indestructible,true

# Tronco (indestructible pero no sólido - para decoración)
T=/lemmings/bloques/tronco.png,decoracion,false

# ========= BLOQUES DESTRUCTIBLES =============
# Pasto (destructible)
P=/lemmings/bloques/pasto.png,destructible,true

# Tierra (variante 1)
1=/lemmings/bloques/tierraGrande.png,destructible,true

# Tierra (variante 2)
2=/lemmings/bloques/tierraCuadrada.png,destructible,true

# Tierra (variante 3)
3=/lemmings/bloques/tierraPiramide.png,destructible,true

# Tierra (variante 4)
4=/lemmings/bloques/tierraPlana.png,destructible,true

# Tierra (variante 5)
5=/lemmings/bloques/tierraCopo.png,destructible,true

# ========= ELEMENTOS ESPECIALES ===============
# Aire (espacio vacío)
 =,aire,false

 # Pinche
 L=,pinche,false

# Spawn point (donde aparecen los lemmings)
S=,spawn,false

# Meta (donde deben llegar)
G=,meta,false